# Chapter: Basics - percent-encoding
# Shows: proxy.percent_decode/percent_encode round-trip, Url.path on escaped input
# Run: lmscript examples/percent-encoding.lms
# Needs: nothing (offline).
# exit: 0
# expect:
#|raw     : /my%20dir/report%231.pdf
#|decoded : /my dir/report#1.pdf
#|encoded : /my%20dir/report%231.pdf
program = _lmcode_ cli="lmproxy" install="github:lmctl-ai/lmproxy@latest";

let u = proxy.parse_url("http://files.example.org/my%20dir/report%231.pdf");
println("raw     : " + u.path());
let decoded = proxy.percent_decode(u.path());
println("decoded : " + decoded);
println("encoded : " + proxy.percent_encode(decoded));

end _lmcode_
r = run_lmcode(program);
require(r.ok, json_stringify(r));
