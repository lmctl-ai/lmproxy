# Chapter: Basics - inspect an HTTP request
# Shows: proxy.parse_request, Message.method/target/version/header/header_names
# Run: LMCODE_COMPILER_MODULE=/path/to/lmctl-mono/lmscript/dist/dsl.js node scripts/compile-lmcode-fixture.mjs examples/inspect-request.lms tests/fixtures/lmcode/inspect-request.dslb && lmproxy --lmcode tests/fixtures/lmcode/inspect-request.dslb
# Needs: nothing (offline); the raw request is embedded below.
# exit: 0
# expect:
#|GET /index.html HTTP/1.1
#|host -> example.com
#|accept -> */*
#|3 header fields
program = _lmcode_ schema="../schema/lmproxy.host.json";

let raw = "GET /index.html HTTP/1.1\r\n"
        + "Host: example.com\r\n"
        + "Accept: */*\r\n"
        + "User-Agent: lmproxy-example\r\n"
        + "\r\n";
let m = proxy.parse_request(raw);

if (!m.complete()) {
  println("parse error: " + m.error());
} else {
  println(m.method() + " " + m.target() + " " + m.version());
  println("host -> " + m.header("HOST"));
  println("accept -> " + m.header("Accept"));
  println(str(m.header_count()) + " header fields");
}

end _lmcode_
