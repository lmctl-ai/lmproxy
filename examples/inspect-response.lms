# Chapter: Basics - inspect an HTTP response
# Shows: proxy.parse_response, Message.status/reason, header defaults, Url flags
# Run: lmscript examples/inspect-response.lms      (then: lmproxy --dsl build/inspect-response.dslb)
# Needs: nothing (offline).
# exit: 0
# expect:
#|HTTP/1.1 301 Moved Permanently
#|redirects to -> https://example.com/new
#|4 header fields
#|default port of https url: 443
#|explicit port present: false
p = _dsl_ cli="lmproxy" install="github:lmctl-ai/lmproxy@latest";

let raw = "HTTP/1.1 301 Moved Permanently\r\n"
        + "Location: https://example.com/new\r\n"
        + "Content-Length: 0\r\n"
        + "Cache-Control: no-store\r\n"
        + "Via: 1.1 lmproxy\r\n"
        + "\r\n";
let r = proxy.parse_response(raw);
println(r.version() + " " + str(r.status()) + " " + r.reason());
println("redirects to -> " + r.header("location"));
println(str(r.header_count()) + " header fields");

let dest = proxy.parse_url(r.header("Location"));
println("default port of " + dest.scheme() + " url: " + str(dest.port()));
println("explicit port present: " + str(dest.has_port()));

end _dsl_
savedsl(p, "build/inspect-response.dslb");
